NODE_ENV=development
PORT=3000
# Compte équipe créé au démarrage (téléphone ivoirien à 10 chiffres + mot de passe de 8 caractères minimum)
ADMIN_PHONE=0700000000
ADMIN_PASSWORD=change-this-password
EMERGENCY_PHONE=0719480884
# Points de retrait séparés par |
PICKUP_POINTS=UTT LOKO ZONE4C|La Fontaine|HEGES
# Mets 1 derrière un proxy HTTPS (Nginx, Caddy, Render...) pour lire la vraie IP des clients
TRUST_PROXY=0
# DB_PATH=/chemin/persistant/groupe-express.db

# Assistant IA OpenAI : ajouter une clé API privée dans .env pour activer les réponses IA réelles.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=https://api.openai.com/v1/responses

# Envoi fournisseur (à connecter ultérieurement à un prestataire SMTP/API)
SUPPLIER_MAIL_HOST=
SUPPLIER_MAIL_PORT=
SUPPLIER_MAIL_USER=
SUPPLIER_MAIL_PASSWORD=
SUPPLIER_MAIL_FROM=

# Notifications push : générer avec npm run vapid:generate puis copier les deux clés dans .env. HTTPS requis hors localhost.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@groupe-express.local

# WhatsApp Business Cloud API : nécessite un compte Meta Business, un numéro WhatsApp Business et un jeton d’accès valide.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v22.0
# En production, utiliser un modèle WhatsApp approuvé si le fournisseur n'a pas ouvert de session de 24 h
WHATSAPP_WEBHOOK_VERIFY_TOKEN=choisir-un-token-long-aleatoire
WHATSAPP_APP_SECRET=
